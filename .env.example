# Copie para `.env` e preencha. O `.env` NUNCA é versionado (ver .gitignore).
# Em produção, estes valores vivem nos Secrets do GitHub.

# --- Coleta (Apify) -------------------------------------------------------
APIFY_TOKEN=
APIFY_ACTOR_ID=scraper_one/facebook-posts-search

# --- LLM (Anthropic) ------------------------------------------------------
ANTHROPIC_API_KEY=
# Juiz diário: modelo pequeno e barato, roda ~30 posts/dia
# (claude-haiku-5-5: US$ 0,10 / US$ 0,50 por milhão de tokens de entrada / saída)
JUDGE_MODEL=claude-haiku-5-5
# Agente semanal: modelo maior, roda 1x por semana e usa ferramentas
# (claude-opus-5-5: US$ 4 / US$ 20 por milhão de tokens; ~US$ 0,50 a 1 por semana)
AGENT_MODEL=claude-opus-5-5

# --- Telegram -------------------------------------------------------------
# Token do @BotFather. O bot não pode ter webhook: as respostas são lidas com getUpdates.
TELEGRAM_BOT_TOKEN=
# Só respostas deste chat contam. Para achar: mande "oi" ao bot e rode
# `uv run prospector telegram chats`.
TELEGRAM_CHAT_ID=

# --- Banco (Postgres no Supabase) -----------------------------------------
# Local: a conexão direta (db.<projeto>.supabase.co) funciona se sua rede tem IPv6.
# GitHub Actions: use a do pooler em modo sessão (aws-0-<região>.pooler.supabase.com),
# porque o Actions não tem IPv6. Senha com @ # % / precisa ir codificada (%40 %23 %25 %2F).
DATABASE_URL=postgresql://user:senha@host:5432/postgres
# Opcional: Postgres para os testes de contrato. Cada teste usa um schema temporário.
TEST_DATABASE_URL=

# --- Cópia das imagens (Supabase Storage) --------------------------------
# A URL de imagem do Facebook expira em dias; a coleta guarda uma cópia no
# bucket PRIVADO post-images. URL do projeto, sem o /rest/v1 do final.
SUPABASE_URL=https://<projeto>.supabase.co
# A chave SECRETA (sb_secret_...), em Project Settings -> API Keys.
# A publicável (sb_publishable_...) não serve: ela não grava no bucket privado.
SUPABASE_SERVICE_KEY=

# --- Orçamento (travas em código, ver arquitetura.md seção 7) -------------
# Teto mensal de posts no Apify. Verificado ANTES de toda chamada.
MONTHLY_RESULT_BUDGET=900
# Teto do orçamento diário calculado (restante do mês / dias restantes).
MAX_DAILY_RESULTS=40
# Quantos posts aprovados podem ir pro Telegram por dia.
MAX_DAILY_NOTIFICATIONS=3

# --- Bandit e ciclo de vida das receitas (arquitetura.md seção 3) ---------
# Esquecimento semanal: acertos e erros são multiplicados por este fator.
RECIPE_DECAY=0.9
MAX_ACTIVE_RECIPES=4
# Aposentadoria: mínimo de tentativas e limite de probabilidade de ser a melhor.
RETIREMENT_MIN_TRIALS=60
RETIREMENT_PROBABILITY_THRESHOLD=0.05
# Peso do histórico importado do FacebookProspector (dado velho vale menos).
LEGACY_PRIOR_WEIGHT=0.2

# --- Triagem determinística (arquitetura.md seção 5) ----------------------
HOME_BASE=Guarulhos
MAX_POST_AGE_HOURS=48
